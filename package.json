{
  "name": "uislash",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*",
    "themes",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "moon run --concurrency 3 :build",
    "typecheck": "moon run --concurrency 3 :typecheck",
    "lint": "moon run --concurrency 3 :lint",
    "lint:testing": "bun scripts/testing-lint-report.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "moon run --concurrency 3 :test",
    "pack:check": "moon run --concurrency 3 :pack-check",
    "storybook": "moon run storybook:storybook"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.6.5",
    "@nx/js": "24.0.6",
    "@playwright/test": "1.65.1",
    "@types/bun": "catalog:",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-testing-library": "7.16.2",
    "nx": "24.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "browserslist": [
    "chrome >= 131",
    "edge >= 131",
    "firefox >= 143",
    "safari >= 18.4",
    "ios_saf >= 18.4"
  ],
  "catalog": {
    "@types/bun": "1.4.4",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.4",
    "vitest": "5.1.0"
  },
  "catalogs": {
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1"
    },
    "typescript-api": {
      "typescript": "5.9.3"
    }
  }
}
