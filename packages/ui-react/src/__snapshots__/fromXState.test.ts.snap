{
  "states": [
    {
      "id": "cart",
      "kind": "initial",
      "label": "cart",
    },
    {
      "id": "abandoned",
      "kind": "terminal",
      "label": "abandoned",
    },
    {
      "id": "paying",
      "kind": "normal",
      "label": "Paying",
      "owner": "billing",
    },
    {
      "id": "shipping",
      "kind": "human",
      "label": "shipping",
      "owner": "warehouse",
    },
    {
      "id": "delivered",
      "kind": "normal",
      "label": "delivered",
    },
    {
      "id": "done",
      "kind": "terminal",
      "label": "done",
    },
    {
      "id": "failed",
      "kind": "failed",
      "label": "Payment failed",
    },
  ],
  "transitions": [
    {
      "event": "CHECKOUT",
      "from": "cart",
