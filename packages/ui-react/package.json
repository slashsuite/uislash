{
  "name": "@slashsuite/ui-react",
  "version": "0.16.3",
  "description": "UISlash React components: primitives, typography roles and a safe Markdown renderer, written against Tailwind v4 utilities. Pair with a theme from @slashsuite/themes.",
  "keywords": [
    "components",
    "design-system",
    "markdown",
    "react",
    "slashsuite",
    "tailwind",
    "tailwindcss",
    "ui"
  ],
  "homepage": "https://github.com/slashsuite/uislash/tree/main/packages/ui-react#readme",
  "bugs": {
    "url": "https://github.com/slashsuite/uislash/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jacobus Langner",
    "url": "https://github.com/madangryscientist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashsuite/uislash.git",
    "directory": "packages/ui-react"
  },
  "files": [
    "dist",
    "agent-docs",
    "skills",
    "MIGRATING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/vendor-core.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives && bun ../../scripts/check-slop.ts",
    "test": "vitest run",
    "agent-docs": "bun ../../tools/docs/scripts/agent-docs.ts",
    "pack-check": "npm pack --dry-run --ignore-scripts && bun scripts/pack-docs.ts && bun scripts/consumer-types.ts",
    "prepack": "bun run build && bun run agent-docs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@internationalized/date": "^3.12.4",
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@slashsuite/core": "0.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "@types/react-dom": ">=18",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "nx": {
    "name": "ui-react"
  }
}
