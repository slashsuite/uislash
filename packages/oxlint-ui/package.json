{
  "name": "@slashsuite/oxlint-ui",
  "version": "0.3.2",
  "description": "An oxlint config and plugin that holds an app to building its UI from @slashsuite/ui-react: no <style>, no raw colour, no dark: variant, no styling prop, no look-alike component, no inline colour and no raw element that has a part.",
  "keywords": [
    "design-system",
    "lint",
    "oxlint",
    "slashsuite",
    "tailwindcss",
    "uislash"
  ],
  "homepage": "https://github.com/slashsuite/uislash/tree/main/packages/oxlint-ui#readme",
  "bugs": {
    "url": "https://github.com/slashsuite/uislash/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jacobus Langner",
    "url": "https://github.com/madangryscientist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashsuite/uislash.git",
    "directory": "packages/oxlint-ui"
  },
  "files": [
    ".oxlintrc.json",
    "plugin.js",
    "ui-react.json",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./.oxlintrc.json": "./.oxlintrc.json",
    "./plugin.js": "./plugin.js",
    "./ui-react.json": "./ui-react.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --ignore-pattern 'fixtures/**' && bun ../../scripts/check-slop.ts",
    "test": "bun scripts/data.ts && vitest run --dir test",
    "pack-check": "bun scripts/data.ts && npm pack --dry-run --json --ignore-scripts | bun scripts/pack-files.ts && bun scripts/consumer.ts",
    "prepack": "bun scripts/data.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "oxlint": "1.94.0"
  },
  "nx": {
    "name": "oxlint-ui"
  }
}
