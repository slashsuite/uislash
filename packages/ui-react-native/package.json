{
  "name": "@slashsuite/ui-react-native",
  "version": "0.0.0",
  "private": true,
  "description": "The UISlash components for React Native, drawn from the same token tables and themes as @slashsuite/ui-react.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts && bun scripts/native-lint.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@slashsuite/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/bun": "catalog:",
    "@types/react": "catalog:react",
    "jsdom": "^31.0.1",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-native": "0.88.1",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": ">=0.88.0"
  }
}
