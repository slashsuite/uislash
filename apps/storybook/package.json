{
  "name": "@slashsuite/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run scripts playwright.config.test.ts",
    "test:e2e": "playwright test",
    "visual": "bun scripts/visual.ts --run",
    "visual:upload": "bun scripts/visual.ts --run --upload"
  },
  "dependencies": {
    "@slashsuite/themes-shared": "workspace:*",
    "@slashsuite/ui-react": "workspace:*",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "storybook": "^10.6.7",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "name": "storybook"
  }
}
