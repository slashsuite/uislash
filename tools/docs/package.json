{
  "name": "@slashsuite/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The component docs' tooling: generates props.json and types.json from ui-react's source, and renders llms.txt and the agent docs @slashsuite/ui-react ships. Dev tooling, not published.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run",
    "props": "bun scripts/props.ts",
    "llms": "bun scripts/llms.ts"
  },
  "dependencies": {
    "@slashsuite/themes-shared": "workspace:*",
    "@slashsuite/ui-react": "workspace:*",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "catalog:typescript-api",
    "vitest": "catalog:"
  },
  "nx": {
    "name": "docs"
  }
}
